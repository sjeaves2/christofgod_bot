# Template for data/events.yaml — copy to data/events.yaml and edit.
#
#   cp data/events.yaml.example data/events.yaml
#
# The real data/events.yaml is NOT tracked in git: the bot writes to it at
# runtime (/setservicelink, /addevent, /modifyevent, /deleteevent), and it holds
# join links whose URLs embed Zoom passcodes. Tracking it put those links in a
# public repository and made every admin edit block deploy/update.sh.
#
# Every join link below is a placeholder. Set the real ones with
# /setservicelink from Telegram rather than by editing this file by hand.

# Notification target registry: friendly name -> Telegram chat_id of a group or
# channel the bot has been added to. Groups/supergroups use negative numeric ids
# (e.g. -1001234567890); public channels may use "@channelusername".
# When the bot is added to a group/channel it logs the chat_id at INFO.
notification_targets:
  cogm_members: -1001234567890
# Example:
# notification_targets:
#   main_group: -1001234567890
#   announcements: "@cogm_announcements"

# Default target(s) for every convocation/Sabbath service (by registry name or
# raw chat_id). Used when a phase is not listed in convocation_targets below.
convocation_targets_default:
  - cogm_members
# Per-service override of broadcast targets, keyed by phase_key
# ("<convocation_key>::<label>", e.g. "sabbath::Eve").
convocation_targets: {}
# Example:
# convocation_targets:
#   "sabbath::Eve": [main_group]
#   "sabbath::Morning": [main_group, announcements]

special_events:
- id: sunday_morning_prayer
  name: Sunday Morning Prayer
  type: weekly
  weekday: 6
  time: 06:00
  duration_minutes: 20
  notification_minutes: 720
  description: Weekly Sunday Morning Prayer service — all are welcome.
  url: https://us06web.zoom.us/j/0000000000?pwd=SETMEWITHSETSERVICELINK
  # Group(s)/channel(s) to post this reminder to (registry names or chat_ids).
  targets:
    - cogm_members
  # Optional media attached to this reminder. Each may be a public https URL or a
  # local file path relative to the project root (e.g. media/flyer.jpg). `image`
  # is sent as a photo, `document` as a file. The reminder text is used as the
  # caption (or a separate message if it exceeds 1024 characters).
  # image: media/sunday-prayer.jpg
  # document: media/bulletin.pdf
  active: true

convocation_announcements: {}
convocation_urls:
  sabbath::Eve: https://us06web.zoom.us/j/0000000000?pwd=SETMEWITHSETSERVICELINK
  sabbath::Morning: https://us06web.zoom.us/j/0000000000?pwd=SETMEWITHSETSERVICELINK
  rosh_hashanah::Eve: https://us06web.zoom.us/j/0000000000?pwd=SETMEWITHSETSERVICELINK
  rosh_hashanah::Morning: https://us06web.zoom.us/j/0000000000?pwd=SETMEWITHSETSERVICELINK
  yom_kippur::Eve: https://us06web.zoom.us/j/0000000000?pwd=SETMEWITHSETSERVICELINK
  yom_kippur::Morning: https://us06web.zoom.us/j/0000000000?pwd=SETMEWITHSETSERVICELINK
  succoth_opening::Eve: https://us06web.zoom.us/j/0000000000?pwd=SETMEWITHSETSERVICELINK
  succoth_closing::Eve: https://us06web.zoom.us/j/0000000000?pwd=SETMEWITHSETSERVICELINK
  succoth_opening::Day: https://us06web.zoom.us/j/0000000000?pwd=SETMEWITHSETSERVICELINK
  succoth_closing::Day: https://us06web.zoom.us/j/0000000000?pwd=SETMEWITHSETSERVICELINK

# Optional per-service media, keyed by phase_key (like convocation_urls). Each
# value is a public https URL or a local file path (media/...). Example:
# convocation_images:
#   "sabbath::Morning": media/sabbath-poster.jpg
# convocation_documents:
#   "sabbath::Eve": https://example.org/order-of-service.pdf
convocation_images: {}
convocation_documents: {}

# systemd unit TEMPLATE for the Christ of God Ministries bot.
#
# __REPO_DIR__ and __RUN_USER__ are substituted by deploy/setup.sh, which
# renders this to /etc/systemd/system/christofgod-bot.service. That keeps the
# deployment independent of where the repository is cloned (~/christofgod_bot,
# ~/repos/christofgod_bot, /opt/...) and of which user runs it.
#
# To install by hand instead:
#   sed -e "s|__REPO_DIR__|$PWD|g" -e "s|__RUN_USER__|$(id -un)|g" \
#       deploy/christofgod-bot.service.template |
#     sudo tee /etc/systemd/system/christofgod-bot.service
#   sudo systemctl daemon-reload && sudo systemctl enable --now christofgod-bot

[Unit]
Description=Christ of God Ministries Telegram bot
Documentation=https://github.com/sjeaves2/christofgod_bot
# Wait for real network connectivity: the bot long-polls api.telegram.org and
# would otherwise log a burst of connection errors at every boot.
After=network-online.target
Wants=network-online.target

# Stop a genuinely broken build (bad config, missing dependency) from
# restart-looping forever — systemd gives up after 5 starts in 5 minutes, which
# `systemctl status` then reports as "start request repeated too quickly".
#
# These MUST live in [Unit]. systemd has parsed them here since v229; left in
# [Service] they are silently ignored ("Unknown key name ... ignoring" in the
# journal) and the limiter never applies at all — which is exactly how this file
# shipped until 2026-09-08.
#
# Note the interaction with the network self-heal in bot.py: that exits after
# ~10 minutes of sustained failure, so self-heal restarts are spaced far wider
# than this 5-minute window and can never trip the limit. Only a fast crash
# loop does, which is the intent.
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=__RUN_USER__
Group=__RUN_USER__
WorkingDirectory=__REPO_DIR__
ExecStart=__REPO_DIR__/.venv/bin/python bot.py

# Keep it running: restart on crash, on a failed Telegram session, on a
# deliberate self-heal exit, or after a reboot. The rate limit that bounds this
# lives in [Unit] above, where systemd actually reads it.
Restart=always
RestartSec=10

# Unbuffered output so journalctl shows log lines as they happen.
Environment=PYTHONUNBUFFERED=1

# Modest hardening. The bot only needs to read its own directory and write
# data/, logs/ and generated/ inside it.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=__REPO_DIR__

# journald keeps a copy of stdout/stderr; the bot also writes logs/bot.log.
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target

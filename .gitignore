# Virtual environment
.venv/
# Second virtualenv on Python 3.12, matching CI's other leg and the server
# (the laptop's system Python is Xcode's 3.9.6). See deploy notes.
.venv312/
.venv*/

# Bot configuration — contains the live token, never commit this
config/config.yaml

# Runtime-generated files
generated/
logs/

# Event configuration. NOT tracked: the bot writes to it at runtime
# (/setservicelink, /addevent, /modifyevent) and its join links embed Zoom
# passcodes. Ship data/events.yaml.example instead.
data/events.yaml

# User and appointment data (contains personal information)
data/users.yaml
data/appointments.yaml
data/appointments_archive.yaml
data/announcements.yaml

# Prayer requests. The most sensitive file the bot holds: health, finances,
# bereavement and family crises in members' own words. This entry was MISSING
# until 2026-10-29 — the file had never been committed, but `git add -A` would
# have staged it, in a public repository. Nothing leaked, partly because
# handlers/prayer.py deletes the request text as soon as a request is answered
# or dismissed, so the live file is usually near-empty. That is a mitigation,
# not a reason to leave this out.
data/prayer_requests.yaml

# Board compliance items. NOT tracked: descriptions carry registration numbers,
# filing account references and renewal portal links, and this repository is
# public. Ship data/board_items.yaml.example instead.
data/board_items.yaml

# Python cache
__pycache__/
*.pyc
*.pyo
.pytest_cache/

# macOS
.DS_Store

# Notification retry state (contains chat_ids)
data/notification_state.yaml

# Discovered group/channel memberships (for /broadcast)
data/known_groups.yaml

# Coverage output
.coverage
